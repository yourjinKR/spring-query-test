# Paste individual queries into http://localhost:9090.
# HTTP duration includes server processing, unlike fetchAndAssembleMs.
histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~"/v[12]/posts"}[1m])))

# Requests per second by route.
sum by (uri) (rate(http_server_requests_seconds_count{uri=~"/v[12]/posts"}[1m]))

# JVM heap bytes and GC pause seconds per second.
sum(jvm_memory_used_bytes{area="heap"})
sum(rate(jvm_gc_pause_seconds_sum[1m]))

# Pool pressure and connection acquisition time. Hikari pool label may vary.
hikaricp_connections_active
hikaricp_connections_pending
rate(hikaricp_connections_acquire_seconds_sum[1m]) / rate(hikaricp_connections_acquire_seconds_count[1m])

# Connection acquisition latency p95, including timeouts recorded by Hikari.
# Acquisition is not pure queue wait. Convert seconds to milliseconds.
1000 * histogram_quantile(0.95, sum by (le, pool) (rate(hikaricp_connections_acquire_seconds_bucket[1m])))

# Borrow-to-return connection occupancy p95 and mean, milliseconds.
1000 * histogram_quantile(0.95, sum by (le, pool) (rate(hikaricp_connections_usage_seconds_bucket[1m])))
1000 * rate(hikaricp_connections_usage_seconds_sum[1m]) / rate(hikaricp_connections_usage_seconds_count[1m])

# Sampled pending peak; brief spikes between scrapes can be missed.
max_over_time(hikaricp_connections_pending[1m])

# Pool utilization and acquisition timeouts. Pool metrics have no route tag:
# run v1 and v2 separately, using the same stable pool configuration.
hikaricp_connections_active / hikaricp_connections_max
increase(hikaricp_connections_timeout_total[1m])
